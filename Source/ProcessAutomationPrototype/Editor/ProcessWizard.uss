.pw-root {
    flex-grow: 1;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 12px;
    padding-right: 12px;
    background-color: rgb(40, 40, 44);
}

.pw-header {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(236, 236, 240);
}

.pw-subtitle {
    margin-bottom: 8px;
    font-size: 11px;
    color: rgb(140, 140, 150);
    white-space: normal;
}

.pw-toolbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    background-color: rgb(29, 29, 32);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(54, 54, 60);
}

.pw-toolbar-tabs {
    flex-direction: row;
    align-items: center;
}

.pw-tab {
    height: 26px;
    min-width: 72px;
    border-width: 0;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(160, 160, 170);
    -unity-font-style: normal;
    margin-left: 2px;
    margin-right: 2px;
    padding-left: 10px;
    padding-right: 10px;
}

.pw-tab:hover {
    background-color: rgb(48, 48, 54);
    color: rgb(210, 210, 218);
}

.pw-tab--active {
    background-color: rgb(56, 114, 178);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.pw-tab--active:hover {
    background-color: rgb(72, 130, 194);
    color: rgb(255, 255, 255);
}

.pw-toolbar-new {
    height: 26px;
    margin-right: 4px;
    background-color: rgb(50, 50, 56);
}

.pw-toolbar-history {
    height: 26px;
    min-width: 28px;
    margin-left: 6px;
    background-color: rgb(50, 50, 56);
}

.pw-toolbar-history--active {
    background-color: rgb(56, 114, 178);
    color: rgb(255, 255, 255);
}

.pw-body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.pw-main {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.pw-history {
    width: 220px;
    flex-shrink: 0;
    flex-direction: column;
    margin-right: 10px;
    min-height: 0;
    background-color: rgb(29, 29, 32);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(54, 54, 60);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    padding-right: 8px;
}

.pw-history-heading {
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(210, 210, 218);
    margin-bottom: 6px;
}

.pw-history-filters {
    flex-direction: row;
    margin-bottom: 6px;
}

.pw-history-filter {
    height: 22px;
    border-width: 0;
    border-radius: 5px;
    background-color: rgb(44, 44, 50);
    color: rgb(150, 150, 160);
    font-size: 10px;
    -unity-font-style: normal;
    padding-left: 6px;
    padding-right: 6px;
    margin-right: 4px;
}

.pw-history-filter--active {
    background-color: rgb(56, 114, 178);
    color: rgb(255, 255, 255);
}

.pw-history-list {
    flex-grow: 1;
    min-height: 80px;
}

.pw-history-empty {
    font-size: 11px;
    color: rgb(120, 120, 130);
    white-space: normal;
    margin-top: 8px;
    display: none;
}

.pw-history-item {
    flex-direction: column;
    align-items: flex-start;
    height: auto;
    border-width: 0;
    border-radius: 7px;
    background-color: rgba(0, 0, 0, 0);
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
    margin-bottom: 2px;
    -unity-font-style: normal;
    -unity-text-align: upper-left;
}

.pw-history-item:hover {
    background-color: rgb(44, 44, 50);
}

.pw-history-item--active {
    background-color: rgb(48, 64, 88);
}

.pw-history-item-title {
    font-size: 11px;
    color: rgb(226, 226, 231);
    white-space: normal;
    margin-bottom: 2px;
}

.pw-history-item-meta {
    flex-direction: row;
    align-items: center;
}

.pw-history-item-mode {
    font-size: 9px;
    color: rgb(120, 150, 200);
    margin-right: 6px;
}

.pw-history-item-date {
    font-size: 9px;
    color: rgb(118, 118, 130);
}

.pw-history-banner {
    font-size: 11px;
    color: rgb(150, 160, 180);
    margin-bottom: 6px;
    margin-left: 4px;
    white-space: normal;
}

.pw-conversation--readonly {
    opacity: 0.92;
}

.pw-composer-actions {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
    margin-left: 4px;
}

.pw-progress {
    font-size: 11px;
    color: rgb(140, 170, 210);
    margin-bottom: 4px;
    margin-left: 4px;
    -unity-font-style: bold;
}

.pw-welcome-hint {
    font-size: 11px;
    color: rgb(132, 132, 142);
    white-space: normal;
    margin-bottom: 8px;
    margin-left: 2px;
}

.pw-welcome-actions {
    align-items: stretch;
}

.pw-welcome-card {
    flex-grow: 1;
    flex-direction: column;
    background-color: rgb(29, 29, 32);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(54, 54, 60);
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
}

.pw-welcome-card-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(226, 226, 231);
    margin-bottom: 4px;
}

.pw-welcome-card-desc {
    font-size: 11px;
    color: rgb(140, 140, 150);
    white-space: normal;
    margin-bottom: 10px;
    flex-grow: 1;
}

.pw-offline-panel {
    background-color: rgb(34, 38, 44);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgb(54, 64, 78);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
    margin-bottom: 6px;
}

.pw-offline-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(170, 190, 220);
    margin-bottom: 4px;
}

.pw-offline-body {
    font-size: 11px;
    color: rgb(150, 155, 165);
    white-space: normal;
}

.pw-restart {
    height: 24px;
    margin-left: 6px;
    background-color: rgb(50, 50, 56);
    font-size: 11px;
    -unity-font-style: normal;
}

.pw-conversation {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    background-color: rgb(29, 29, 32);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(54, 54, 60);
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 10px;
    padding-right: 10px;
}

.pw-msg {
    flex-direction: column;
    margin-top: 5px;
    margin-bottom: 5px;
    max-width: 88%;
}

.pw-msg--assistant {
    align-self: flex-start;
    align-items: flex-start;
}

.pw-msg--user {
    align-self: flex-end;
    align-items: flex-end;
}

.pw-role {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(118, 118, 130);
    margin-bottom: 2px;
    margin-left: 4px;
    margin-right: 4px;
}

.pw-bubble {
    white-space: normal;
    font-size: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.pw-bubble--assistant {
    background-color: rgb(48, 48, 54);
    color: rgb(226, 226, 231);
    border-bottom-left-radius: 4px;
}

.pw-bubble--user {
    background-color: rgb(56, 114, 178);
    color: rgb(246, 249, 253);
    border-bottom-right-radius: 4px;
}

.pw-composer {
    flex-shrink: 0;
    flex-direction: column;
    margin-top: 10px;
}

.pw-composer-row {
    flex-direction: row;
    align-items: center;
    background-color: rgb(29, 29, 32);
    border-radius: 10px;
    border-width: 1px;
    border-color: rgb(54, 54, 60);
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
}

.pw-error {
    color: rgb(230, 120, 120);
    font-size: 11px;
    margin-bottom: 4px;
    margin-left: 4px;
    white-space: normal;
}

.pw-input {
    flex-grow: 1;
    min-height: 26px;
}

.pw-input > .unity-base-text-field__input {
    background-color: rgb(38, 38, 42);
    border-color: rgb(62, 62, 70);
    border-radius: 7px;
}

.pw-btn {
    height: 28px;
    border-width: 0;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    background-color: rgb(64, 64, 72);
    color: rgb(230, 230, 236);
    -unity-font-style: bold;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.pw-btn:hover {
    background-color: rgb(80, 80, 90);
}

.pw-btn:active {
    background-color: rgb(92, 92, 104);
}

.pw-btn--primary {
    background-color: rgb(56, 130, 200);
    color: rgb(255, 255, 255);
}

.pw-btn--primary:hover {
    background-color: rgb(72, 148, 220);
}

.pw-btn--primary:active {
    background-color: rgb(48, 118, 186);
}

.pw-grow {
    flex-grow: 1;
}

.pw-picker {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.pw-send {
    margin-left: 6px;
}

.pw-gap {
    margin-left: 8px;
}

.pw-undo {
    width: 32px;
    height: 28px;
    margin-right: 8px;
    padding-left: 0;
    padding-right: 0;
    background-color: rgb(50, 50, 56);
    color: rgb(202, 202, 212);
}

.pw-undo:hover {
    background-color: rgb(66, 66, 74);
}

.pw-hint {
    color: rgb(132, 132, 142);
    font-size: 11px;
    margin-top: 8px;
    white-space: normal;
}

.pw-engine {
    margin-bottom: 6px;
}

.pw-config {
    margin-bottom: 4px;
}

.pw-config > .unity-base-text-field__input {
    background-color: rgb(38, 38, 42);
    border-color: rgb(62, 62, 70);
    border-radius: 7px;
}

.pw-linklike {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgb(120, 150, 200);
    font-size: 11px;
    align-self: flex-start;
    margin-top: 6px;
    padding-left: 2px;
    padding-right: 2px;
}

.pw-linklike:hover {
    color: rgb(150, 180, 230);
}
